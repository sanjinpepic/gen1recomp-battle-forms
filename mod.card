-- Sharing metadata.  Read by tooling and the manager's detail pane; never by
-- the loader's merge, so nothing here can break a load.
return {
  summary = "Mid-battle form changes, with mega evolution as the first trigger.",
  author = "sanjinpepic",
  contact = "https://github.com/sanjinpepic",
  tags = { "gameplay", "battle" },
  differences = {
    changed = {
      "a MEGA entry on the battle menu, shown only when the active mon carries a matching stone, arms a mega evolution",
    },
    added = {
      "a form change that resolves before turn order, so megaing never spends a turn or a move",
      "mega stones as bag items; using one on a mon it fits assigns it to that mon and is not used up",
      "96 mega forms across 87 species -- every mainline-game mega evolution plus every National Dex mega that has its own art, each sold under its own stone",
      "the form survives switching out and unwinds when the battle ends or the mon faints",
    },
    known = {
      "abilities are unaffected -- nothing here makes an ability do anything, and no ability animations ship yet",
      "Gold is not supported; this is Red/Blue/Yellow only for now",
      "a mon exported to a Game Boy .sav loses its stone, because a cart save has nowhere to record one",
      "there is no Key Stone: carrying the matching stone is the only requirement, where the real games also gate on the trainer",
      "the form lasts the battle and is never written to the save",
      "one National Dex mega, Meowstic (female), has no art in the installed sprite sets and is not wired -- it would show the ordinary Meowstic sprite with a mega's stats",
    },
  },
  credits = {
    { who = "National Dex", for_ = "the alternate-form records every form change reads its stats and types from" },
  },
  compat = { engine = ">=0.0.0-0 <2.0.0", modApi = 2 },
}
